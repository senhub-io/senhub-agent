<?xml version="1.0" encoding="UTF-8"?>
<!--
  SenHub Agent — Windows MSI source (WiX Toolset v4+).

  Build (cross-platform, requires the WiX dotnet tool + the Windows
  binary staged at $(BinDir)\senhub-agent.exe):

      wix build packaging/windows/senhub-agent.wxs ^
        -d Version=0.2.0 ^
        -d BinDir=dist\windows-amd64 ^
        -arch x64 ^
        -ext WixToolset.Util.wixext ^
        -out dist\senhub-agent-0.2.0-amd64.msi

  The MSI installs senhub-agent.exe into %ProgramFiles%\SenHub Agent\,
  registers the "senhub-agent" Windows service (matching the kardianos
  service.Config Name in cmd/agent/service.go), and supports silent
  install with parametric configuration. The agent is OFFLINE by default
  (local scrape endpoints); the only provisionable fields are the license
  token (paid probe tiers) and host tags — there is no cloud backend or
  auth token to seed:

      msiexec /i senhub-agent.msi /qn ^
        LICENSE_FILE=C:\licences\license-client1-Pro.jwt ^
        TAGS=site=paris,env=prod ^
        HTTP_PORT=9080 DESKTOP_SHORTCUT=0

  LICENSE_FILE=<path> names the licence file (what the wizard's Browse
  button fills in); LICENSE_KEY=<jwt> carries the token itself, for
  scripted installs.

  HTTP_PORT moves the local HTTP endpoints (PRTG, Web UI, Nagios) off
  the 8080 default. The seeding step refuses a port already in use, and
  the install fails with it: a service that starts on a taken port runs,
  logs one line and answers nothing, which is worse than a refusal.

  An upgrade keeps operator state under %ProgramData%\SenHub (config,
  sealed secret store, license) so it is never lost across versions. A
  genuine uninstall removes the whole tree, so removing the product
  leaves the machine clean and a later fresh install starts from the
  installer's inputs rather than a stale kept config. The transient
  subfolders logs\ and update\ (rotated logs and staged auto-update
  MSIs — both regenerated on next run) are
  removed on a plain uninstall so it leaves a clean tree. A full data
  purge, including config and secrets, is opt-in:

      msiexec /x senhub-agent.msi /qn PURGE_DATA=1

  See docs/deployment/windows-msi.md for GPO / SCCM / Intune deployment.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <!--
    The UpgradeCode MUST remain stable across all versions so that
    major upgrades (clean replace of an older MSI) are detected.
    NEVER regenerate this GUID once shipped.
  -->
  <?define UpgradeCode = "8E0E0B5C-2C8F-4C4B-9E2A-1B0D7F9A6C31" ?>
  <?define ServiceName = "senhub-agent" ?>
  <?define ServiceDisplayName = "SenHub Agent" ?>
  <?define ServiceDescription = "SenHub Agent Service for monitoring and management" ?>

  <Package
      Name="SenHub Agent"
      Manufacturer="Sensor Factory"
      Version="$(Version)"
      UpgradeCode="$(UpgradeCode)"
      Scope="perMachine"
      Compressed="yes"
      InstallerVersion="500">

    <!-- Embed the cabinet inside the MSI so a single file ships. -->
    <MediaTemplate EmbedCab="yes" />

    <!--
      Clean major-upgrade story: a newer MSI removes the older product
      first, then installs. Config under %ProgramData%\SenHub is NOT
      owned by the MSI (see comment on the config component), so it
      survives the upgrade automatically.
    -->
    <MajorUpgrade
        DowngradeErrorMessage="A newer version of [ProductName] is already installed."
        Schedule="afterInstallInitialize" />

    <!--
      Block a colliding FOREIGN install with clear guidance. Proceed when:
      this is maintenance/uninstall (Installed), our own prior MSI is
      present (MSI_MARKER), the box is clean (no EXISTING_SERVICE), or the
      operator opted into migration (ADOPT). Otherwise stop with a message
      rather than fail obscurely on ServiceInstall.

      The message shows in a single-button (OK) dialog that aborts setup, so
      it states plainly that setup is stopping and gives two copy-pasteable
      command-line actions rather than an in-dialog "choose an option".
    -->
    <Launch
        Condition="Installed OR MSI_MARKER OR NOT EXISTING_SERVICE OR ADOPT"
        Message="SenHub Agent is already installed on this machine by another method (not by this installer), so setup will now stop. Do one of these from an elevated command prompt, then run setup again: (1) To keep the current agent and let this installer manage it from now on, re-run setup with ADOPT=1 — for example: msiexec /i senhub-agent.msi ADOPT=1. (2) Or remove the current agent first — run: sc stop senhub-agent  and then  sc delete senhub-agent. Either way, your configuration in %ProgramData%\SenHub is preserved." />

    <!-- ============================================================ -->
    <!-- Parametric configuration via public MSI properties.          -->
    <!-- Public (uppercase) properties can be set on the msiexec       -->
    <!-- command line for silent / GPO / SCCM / Intune deployment.     -->
    <!-- ============================================================ -->
    <!--
      LICENSE_KEY unlocks paid probe tiers (Free needs none). TAGS is a
      comma-separated k=v list applied as host global_tags. There is no
      cloud backend/token: the agent is offline by default (see header).
    -->
    <Property Id="LICENSE_KEY" Secure="yes" Hidden="yes" />
    <!-- Path to the licence file (.jwt) the customer received. This is what
         the wizard asks for: a token is far too long to type. Read by the
         seeding step, which runs as SYSTEM: a mapped drive letter is not
         visible there, use a local path or a UNC path. -->
    <Property Id="LICENSE_FILE" Secure="yes" />
    <!-- The wizard's Browse button opens the Explorer file picker through
         the BrowseLicenseFile script action below, which writes the chosen
         path into LICENSE_FILE. -->
    <Property Id="TAGS" Secure="yes" />
    <!-- Optional: push metrics/logs to an OTLP collector (host:port). -->
    <Property Id="OTLP_ENDPOINT" Secure="yes" />
    <!-- Port of the local HTTP endpoints. Defaulted so the options page
         shows the value the seeding step will use. -->
    <Property Id="HTTP_PORT" Value="8080" Secure="yes" />
    <!-- Desktop shortcut to the web console (1 = create, the default;
         DESKTOP_SHORTCUT=0 on the command line skips it). -->
    <Property Id="DESKTOP_SHORTCUT" Value="1" Secure="yes" />
    <!-- Open the web console when the wizard finishes (guided install
         only: the launch is wired to the finish page's button). -->
    <Property Id="OPEN_CONSOLE" Value="1" Secure="yes" />
    <!--
      PURGE_DATA=1 on `msiexec /x` deletes %ProgramData%\SenHub in full
      on uninstall (config, sealed secret store, license, logs, staged
      updates). Deliberately OPT-IN: the default uninstall preserves the
      operator state (config, secrets, license) so a reinstall or upgrade
      never loses it. Note that the default uninstall still removes the
      transient logs\ and update\ subfolders (see PurgeLogsFolder /
      PurgeUpdateFolder on the DataFolderMarker component below); PURGE_DATA=1
      additionally removes the preserved state. See the PurgeDataFolder
      authoring on the DataFolderMarker component below.
    -->
    <!-- PURGE_DATA is retained for backward compatibility only: a genuine
         uninstall now removes %ProgramData%\SenHub in full regardless, so
         this property no longer changes anything. -->
    <Property Id="PURGE_DATA" Secure="yes" />

    <!--
      Keep the license token out of the MSI log. Secure="yes" only lets a
      public property survive the transition to the deferred/system context
      — it does NOT redact it. A verbose install (/l*v) would otherwise
      record the LICENSE_KEY property value and the SeedConfig deferred
      custom-action data (the config-init command line embeds the token,
      see SetProperty below). In WiX v4/v5 the special MsiHiddenProperties
      property cannot be authored directly (WIX0070); redaction is expressed
      per element instead — Hidden="yes" on the LICENSE_KEY Property above,
      and HideTarget="yes" on the SeedConfig CustomAction below.
    -->

    <!-- ============================================================ -->
    <!-- Existing-install detection.                                  -->
    <!-- EXISTING_SERVICE is set when the senhub-agent Windows service -->
    <!-- is registered; MSI_MARKER is set when THIS installer ran      -->
    <!-- before. A service present WITHOUT our marker is a FOREIGN     -->
    <!-- install (kardianos / `agent install` / a ZIP deploy), which   -->
    <!-- would collide with our ServiceInstall — so we either block    -->
    <!-- with guidance or, with ADOPT=1, migrate it to MSI management. -->
    <!-- ============================================================ -->
    <Property Id="EXISTING_SERVICE">
      <RegistrySearch Id="FindAgentService" Root="HKLM"
                      Key="SYSTEM\CurrentControlSet\Services\senhub-agent"
                      Name="ImagePath" Type="raw" />
    </Property>
    <Property Id="MSI_MARKER">
      <RegistrySearch Id="FindMsiMarker" Root="HKLM"
                      Key="SOFTWARE\Sensor Factory\SenHub Agent"
                      Name="Version" Type="raw" />
    </Property>
    <!-- ADOPT=1 takes over a foreign install: stop + delete its service
         before installing ours, preserving %ProgramData%\SenHub config. -->
    <Property Id="ADOPT" Secure="yes" />

    <!--
      Seed %ProgramData%\SenHub\agent.yaml at install time, but ONLY when
      the file does not already exist — so an upgrade or reinstall
      preserves operator configuration (acceptance: "préserver config
      existante"). `config init` is itself idempotent (it no-ops on an
      existing config), so this is belt-and-braces.

      We invoke the installed binary's `config init` path rather than
      templating YAML inside the MSI, so the schema stays owned by the
      agent: it writes the default offline multi-file layout, then applies
      the license + tags (a genuine uninstall later removes the whole
      tree, so a fresh install always starts from the installer inputs).
      Validated on a real Windows host (see
      docs/deployment/windows-msi.md, "Config seeding").

      Return="check": a failed seeding fails the install. config init
      exits non-zero on an invalid property value and on an HTTP port
      already in use; both used to be swallowed, leaving a service that
      started on its defaults with nothing the operator asked for. The
      idempotency guard makes a rerun on an existing config a no-op, so
      repair and reinstall are unaffected.
    -->
    <SetProperty Id="SeedConfig"
                 Value="&quot;[INSTALLFOLDER]senhub-agent.exe&quot; config init --config-path &quot;[CommonAppDataFolder]SenHub\agent.yaml&quot; --license &quot;[LICENSE_KEY]&quot; --tags &quot;[TAGS]&quot; --otlp-endpoint &quot;[OTLP_ENDPOINT]&quot; --http-port &quot;[HTTP_PORT]&quot; --license-file &quot;[LICENSE_FILE]&quot;"
                 Before="SeedConfig"
                 Sequence="execute"
                 Condition="NOT Installed" />

    <CustomAction Id="SeedConfig"
                  BinaryRef="Wix4UtilCA_X64"
                  DllEntry="WixQuietExec64"
                  Execute="deferred"
                  Impersonate="no"
                  HideTarget="yes"
                  Return="check" />

    <!--
      ADOPT migration: stop and delete the foreign service before our
      ServiceInstall creates ours, so the MSI takes over cleanly. Runs
      only when ADOPT is set, a foreign service exists, and it is not our
      own install. Config under %ProgramData%\SenHub is left intact.
    -->
    <SetProperty Id="AdoptExisting"
                 Value="cmd.exe /c &quot;sc stop senhub-agent &amp; sc delete senhub-agent&quot;"
                 Before="AdoptExisting"
                 Sequence="execute"
                 Condition="ADOPT AND EXISTING_SERVICE AND NOT MSI_MARKER AND NOT Installed" />

    <CustomAction Id="AdoptExisting"
                  BinaryRef="Wix4UtilCA_X64"
                  DllEntry="WixQuietExec64"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <!--
      Transient/data folder purge (issues #626 data, #648 logs+update) —
      hardened for #707.

      util:RemoveFolderEx (on the DataFolderMarker component below) deletes
      the tree its Property points to when the component is uninstalled.
      Wix4RemoveFoldersEx processes ALL three RemoveFolderEx rows in ONE
      immediate custom action, and it treats an EMPTY folder property as a
      fatal error (0x80070057 "Missing folder property") that ABORTS the
      whole action — taking the sibling rows down with it. The pre-#707
      authoring left a property empty when its folder should not be purged;
      the instant PURGEDATAFOLDER was empty (i.e. every default uninstall)
      the action aborted and the logs\/update\ purge (#648) silently never
      ran. Recette on Windows Server 2025 caught this: default uninstall
      left logs\ and update\ behind.

      Fix: every property is ALWAYS assigned, so no row is ever empty. When
      a folder must NOT be purged the property points at a sentinel
      subfolder that never exists (SenHub\__no_purge__) — RemoveFolderEx
      enumerates nothing and no-ops WITHOUT the empty-property error. A
      conditional override then repoints the property at the real folder
      only when it should be removed:

        - PURGEDATAFOLDER   → whole tree, only on PURGE_DATA=1 full uninstall.
        - PURGELOGSFOLDER   → logs\,   on any genuine full uninstall.
        - PURGEUPDATEFOLDER → update\, on any genuine full uninstall.

      Gate terms (see InstallExecuteSequence below):
        - REMOVE~="ALL"            → full product removal (`msiexec /x`),
                                     not a repair or feature change.
        - NOT UPGRADINGPRODUCTCODE → not the old product removed by a
                                     MajorUpgrade; upgrade never purges data.
        - NOT WIX_UPGRADE_DETECTED → belt-and-braces for the new product's
                                     session of an upgrade.

      The set-property actions run After AppSearch (defaults first, real-path
      overrides after) so the properties are populated before
      Wix4RemoveFoldersEx snapshots the tree into the RemoveFile table.
      [CommonAppDataFolder] is a standard folder property, resolved at that
      point (the DATAFOLDER Directory id would not be — it costs later).
    -->
    <CustomAction Id="SetPurgeDataDefault"   Property="PURGEDATAFOLDER"   Value="[CommonAppDataFolder]SenHub\__no_purge__" />
    <CustomAction Id="SetPurgeLogsDefault"   Property="PURGELOGSFOLDER"   Value="[CommonAppDataFolder]SenHub\__no_purge__" />
    <CustomAction Id="SetPurgeUpdateDefault" Property="PURGEUPDATEFOLDER" Value="[CommonAppDataFolder]SenHub\__no_purge__" />
    <CustomAction Id="SetPurgeDataReal"      Property="PURGEDATAFOLDER"   Value="[CommonAppDataFolder]SenHub" />
    <CustomAction Id="SetPurgeLogsReal"      Property="PURGELOGSFOLDER"   Value="[CommonAppDataFolder]SenHub\logs" />
    <CustomAction Id="SetPurgeUpdateReal"    Property="PURGEUPDATEFOLDER" Value="[CommonAppDataFolder]SenHub\update" />

    <InstallExecuteSequence>
      <!-- #707: assign every RemoveFolderEx property before Wix4RemoveFoldersEx
           snapshots the tree. Defaults (a never-existing sentinel path) run
           first so no property is ever empty; real-path overrides run after,
           each under its purge gate. -->
      <Custom Action="SetPurgeDataDefault"   After="AppSearch" />
      <Custom Action="SetPurgeLogsDefault"   After="SetPurgeDataDefault" />
      <Custom Action="SetPurgeUpdateDefault" After="SetPurgeLogsDefault" />
      <Custom Action="SetPurgeDataReal"      After="SetPurgeUpdateDefault"
              Condition="Installed AND (REMOVE~=&quot;ALL&quot;) AND NOT UPGRADINGPRODUCTCODE AND NOT WIX_UPGRADE_DETECTED" />
      <Custom Action="SetPurgeLogsReal"      After="SetPurgeDataReal"
              Condition="Installed AND (REMOVE~=&quot;ALL&quot;) AND NOT UPGRADINGPRODUCTCODE AND NOT WIX_UPGRADE_DETECTED" />
      <Custom Action="SetPurgeUpdateReal"    After="SetPurgeLogsReal"
              Condition="Installed AND (REMOVE~=&quot;ALL&quot;) AND NOT UPGRADINGPRODUCTCODE AND NOT WIX_UPGRADE_DETECTED" />
      <!-- Take over a foreign service before InstallServices creates ours. -->
      <Custom Action="AdoptExisting" Before="InstallServices"
              Condition="ADOPT AND EXISTING_SERVICE AND NOT MSI_MARKER AND NOT Installed" />
      <!-- After files are laid down, before the service starts. -->
      <Custom Action="SeedConfig" After="InstallFiles" Condition="NOT Installed" />
    </InstallExecuteSequence>

    <Feature Id="Main" Title="SenHub Agent" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
    </Feature>

    <!-- ============================================================ -->
    <!-- Guided installer UI.                                          -->
    <!-- WixUI_InstallDir gives the standard wizard flow: Welcome →    -->
    <!-- EULA → install directory → ready → progress → finish. A       -->
    <!-- silent install (/qn) skips the UI entirely and drives the     -->
    <!-- same properties from the command line / transform.            -->
    <!--                                                               -->
    <!-- The SenHub options page (SenHubOptionsDlg below) is inserted   -->
    <!-- after the directory page: licence key, HTTP port and the      -->
    <!-- desktop shortcut, open the console at the end. TAGS and       -->
    <!-- OTLP_ENDPOINT stay command-line                               -->
    <!-- properties: they belong to fleet provisioning, not to a       -->
    <!-- person clicking through a wizard.                             -->
    <!-- ============================================================ -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />

    <UI>
      <!--
        Options page. Licence and port are the two settings a person
        installing by hand needs before the service starts: the port
        decides whether the console answers at all, and the web console
        cannot set the port that keeps it from answering.

        The port field takes integers only; the range is checked on Next
        and refused with SenHubBadPortDlg before anything is installed.
        A port already in use is refused later by the seeding step, which
        fails the install (see SeedConfig).
      -->
      <Dialog Id="SenHubOptionsDlg" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="300" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Agent options" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="330" Height="15" Transparent="yes" NoPrefix="yes" Text="Licence, console port and shortcut. Everything else is set from the web console." />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />

        <Control Id="LicenseLabel" Type="Text" X="20" Y="58" Width="330" Height="24" NoPrefix="yes" Text="Licence file (the .jwt file you received; leave empty for the Free tier, a licence can be added later from the web console):" />
        <Control Id="LicenseFileEdit" Type="Edit" X="20" Y="84" Width="264" Height="18" Property="LICENSE_FILE" />
        <Control Id="LicenseBrowse" Type="PushButton" X="290" Y="84" Width="60" Height="18" Text="B&amp;rowse...">
          <Publish Event="DoAction" Value="BrowseLicenseFile" Order="1" />
          <!-- An edit control does not repaint when an action changes its
               property; publishing the property to itself does. -->
          <Publish Property="LICENSE_FILE" Value="[LICENSE_FILE]" Order="2" />
        </Control>

        <Control Id="PortLabel" Type="Text" X="20" Y="112" Width="330" Height="24" NoPrefix="yes" Text="Port of the web console and of the PRTG / Nagios endpoints, on this machine only (default 8080):" />
        <Control Id="PortEdit" Type="Edit" X="20" Y="138" Width="60" Height="18" Property="HTTP_PORT" Integer="yes" />
        <Control Id="PortHint" Type="Text" X="86" Y="141" Width="264" Height="15" NoPrefix="yes" Text="The console will answer on http://localhost:&lt;port&gt;/" />

        <Control Id="ShortcutCheck" Type="CheckBox" X="20" Y="172" Width="330" Height="17" Property="DESKTOP_SHORTCUT" CheckBoxValue="1" Text="Create a desktop shortcut to the web console" />
        <Control Id="OpenConsoleCheck" Type="CheckBox" X="20" Y="192" Width="330" Height="17" Property="OPEN_CONSOLE" CheckBoxValue="1" Text="Open the web console when setup completes" />

        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="&amp;Back">
          <Publish Event="NewDialog" Value="InstallDirDlg" />
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="&amp;Next">
          <Publish Event="SpawnDialog" Value="SenHubBadPortDlg" Order="1" Condition="NOT HTTP_PORT OR HTTP_PORT &lt; 1 OR HTTP_PORT &gt; 65535" />
          <Publish Event="NewDialog" Value="VerifyReadyDlg" Order="2" Condition="HTTP_PORT &gt;= 1 AND HTTP_PORT &lt;= 65535" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>

      <Dialog Id="SenHubBadPortDlg" Width="260" Height="85" Title="[ProductName] Setup" NoMinimize="yes">
        <Control Id="Text" Type="Text" X="48" Y="15" Width="194" Height="30" NoPrefix="yes" Text="The port must be a number between 1 and 65535." />
        <Control Id="Icon" Type="Icon" X="15" Y="15" Width="24" Height="24" ToolTip="Information icon" FixedSize="yes" IconSize="32" Text="WixUI_Ico_Info" />
        <Control Id="Return" Type="PushButton" X="100" Y="57" Width="56" Height="17" Default="yes" Cancel="yes" Text="OK">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
      </Dialog>

      <!-- Insert the options page between the directory page and the
           summary. A later Order on the same control wins over the
           NewDialog the built-in set publishes. -->
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="SenHubOptionsDlg" Order="5" Condition="WIXUI_DONTVALIDATEPATH OR WIXUI_INSTALLDIR_VALID=&quot;1&quot;" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="SenHubOptionsDlg" Order="3" Condition="NOT Installed" />

      <!-- Finish page: standard, untouched. The "open the console" choice
           lives on the options page: the built-in optional checkbox of
           ExitDialog paints an opaque grey band over the dialog image,
           and the address itself is not shown anywhere in the wizard,
           since it ends with the agent key, which the wizard cannot read
           back (sealed for SYSTEM and elevated administrators).
           Finish hands the Start Menu shortcut to the shell, exactly what
           a click on it does: the agent asks for elevation itself to read
           the sealed key, then opens the browser with the user's rights.
           A hidden, waited-for launch (WixQuietExec) of the same command
           never showed a browser. -->
      <Publish Dialog="ExitDialog" Control="Finish" Property="WixShellExecTarget" Value="[ProgramMenuDir]SenHub Agent Console.lnk" Order="1" Condition="OPEN_CONSOLE = 1 AND NOT Installed" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchConsole" Order="2" Condition="OPEN_CONSOLE = 1 AND NOT Installed" />
    </UI>

    <!-- The wizard's Browse button. Windows Installer has no file picker of
         its own; this script action opens the Explorer folder browser in
         "include files" mode and writes the chosen path into LICENSE_FILE.
         A script action needs no DLL and no runtime: two builds of a managed
         (DTF) DLL were called by the engine and returned in three
         milliseconds without ever reaching their code. -->
    <Binary Id="BrowseLicenseScript" SourceFile="packaging/windows/browse-license.vbs" />
    <CustomAction Id="BrowseLicenseFile"
                  BinaryRef="BrowseLicenseScript"
                  VBScriptCall="BrowseLicenseFile"
                  Execute="immediate"
                  Return="ignore" />

    <CustomAction Id="LaunchConsole"
                  BinaryRef="Wix4UtilCA_X64"
                  DllEntry="WixShellExec"
                  Execute="immediate"
                  Impersonate="yes"
                  Return="ignore" />
    <WixVariable Id="WixUILicenseRtf" Value="packaging/windows/license.rtf" />
    <!-- SenHub-branded wizard art (mascot + brand accent), replacing the
         default WiX bitmaps. Dialog = 493x312 (Welcome/Finish background),
         Banner = 493x58 (interior dialog top). -->
    <WixVariable Id="WixUIDialogBmp" Value="packaging/windows/dialog.bmp" />
    <WixVariable Id="WixUIBannerBmp" Value="packaging/windows/banner.bmp" />

    <!-- Add/Remove Programs icon = the SenHub Agent mascot. -->
    <Icon Id="senhub.ico" SourceFile="packaging/windows/senhub.ico" />
    <Property Id="ARPPRODUCTICON" Value="senhub.ico" />

    <!-- ============================================================ -->
    <!-- Install layout.                                              -->
    <!--   %ProgramFiles%\SenHub Agent\senhub-agent.exe  (binary)    -->
    <!--   %ProgramData%\SenHub\                          (config)    -->
    <!-- ============================================================ -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="SenHub Agent" />
    </StandardDirectory>

    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="DATAFOLDER" Name="SenHub" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ProgramMenuDir" Name="SenHub Agent" />
    </StandardDirectory>


    <ComponentGroup Id="ProductComponents">

      <!-- The agent binary + the Windows service registration. -->
      <Component Id="AgentExe" Directory="INSTALLFOLDER" Guid="*">
        <File Id="SenHubAgentExe"
              Name="senhub-agent.exe"
              Source="$(BinDir)\senhub-agent.exe"
              KeyPath="yes" />

        <!--
          Register the Windows service. Name + DisplayName + Description
          mirror cmd/agent/service.go svcConfig so an MSI-installed
          service is indistinguishable from one created by
          `senhub-agent install`. ExecStart args match the offline-only
          model (0.2.0+): the run verb with the canonical config path.
        -->
        <ServiceInstall
            Id="SenHubAgentService"
            Name="$(ServiceName)"
            DisplayName="$(ServiceDisplayName)"
            Description="$(ServiceDescription)"
            Type="ownProcess"
            Start="auto"
            ErrorControl="normal"
            Account="LocalSystem"
            Arguments="run --config-path &quot;[CommonAppDataFolder]SenHub\agent.yaml&quot;"
            Vital="yes">
          <!-- Mirror the kardianos recovery policy: restart on failure. -->
          <util:ServiceConfig
              FirstFailureActionType="restart"
              SecondFailureActionType="restart"
              ThirdFailureActionType="restart"
              RestartServiceDelayInSeconds="10"
              ResetPeriodInDays="1" />
        </ServiceInstall>

        <!-- Start on install, stop+remove on uninstall. -->
        <ServiceControl
            Id="SenHubAgentServiceControl"
            Name="$(ServiceName)"
            Start="install"
            Stop="both"
            Remove="uninstall"
            Wait="yes" />
      </Component>

      <!--
        Desktop shortcut to the web console, on the all-users desktop of
        a per-machine install. It carries no address: it runs the agent's
        `console` verb, which reads the sealed key (asking for elevation
        once) and opens the browser. Removed with the product.
      -->
      <!-- Start Menu shortcut, always present: it is what the Finish page
           launches when "open the web console" is ticked, exactly the
           shortcut a person would click. -->
      <Component Id="ConsoleMenuShortcut" Directory="ProgramMenuDir" Guid="*">
        <RegistryValue Root="HKLM"
                       Key="SOFTWARE\Sensor Factory\SenHub Agent"
                       Name="MenuShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
        <Shortcut Id="ConsoleMenuShortcutLnk"
                  Name="SenHub Agent Console"
                  Description="Open the SenHub Agent web console"
                  Target="[#SenHubAgentExe]"
                  Arguments="console"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="senhub.ico"
                  Show="minimized" />
        <RemoveFolder Id="RemoveProgramMenuDir" Directory="ProgramMenuDir" On="uninstall" />
      </Component>

      <Component Id="ConsoleShortcut" Directory="DesktopFolder" Guid="*" Condition="DESKTOP_SHORTCUT = 1">
        <RegistryValue Root="HKLM"
                       Key="SOFTWARE\Sensor Factory\SenHub Agent"
                       Name="DesktopShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
        <Shortcut Id="ConsoleDesktopShortcut"
                  Name="SenHub Agent Console"
                  Description="Open the SenHub Agent web console"
                  Target="[#SenHubAgentExe]"
                  Arguments="console"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="senhub.ico"
                  Show="minimized" />
      </Component>

      <!--
        Config directory ownership.

        The config file itself is intentionally NOT installed as an MSI
        File: if the MSI owned it, an uninstall would delete operator
        configuration and a repair would overwrite it. Instead the agent
        generates %ProgramData%\SenHub\agent.yaml on first service start
        (generateOfflineConfiguration in cmd/agent/service.go) seeded from
        the BACKEND_URL / AGENT_TOKEN properties via the WriteConfig custom
        action below. This keeps "clean uninstall" and "preserve config on
        upgrade" both true: the MSI removes only what it created.

        We register the directory as a component (with an empty keypath
        registry value) so the install is well-formed, but we do NOT mark
        the directory for removal — leftover operator config is preferred
        over data loss on uninstall (acceptance criterion: no orphan files
        OUTSIDE user preference; config is user preference).

        Default uninstall still leaves a clean tree: the transient logs\
        and update\ subfolders (rotated logs, staged auto-update MSIs) are
        removed by PurgeLogsFolder / PurgeUpdateFolder below, gated on a
        genuine full uninstall (not an upgrade) — see the set-property
        authoring above. Only config, the sealed secret store and the
        license are preserved.

        A genuine uninstall removes the whole tree — config, the sealed
        secret store, the license and staged MSIs — so removing the product
        leaves nothing behind. RemoveFolderEx reads PURGEDATAFOLDER, set to
        the whole tree on a genuine full uninstall and to the never-existing
        sentinel path on a MajorUpgrade (which must preserve operator
        state); the sentinel no-ops without aborting the sibling purges
        (#707). PURGE_DATA is no longer consulted for this.
      -->
      <Component Id="DataFolderMarker" Directory="DATAFOLDER" Guid="*">
        <RegistryValue Root="HKLM"
                       Key="SOFTWARE\Sensor Factory\SenHub Agent"
                       Name="InstallFolder"
                       Type="string"
                       Value="[INSTALLFOLDER]"
                       KeyPath="yes" />
        <RegistryValue Root="HKLM"
                       Key="SOFTWARE\Sensor Factory\SenHub Agent"
                       Name="Version"
                       Type="string"
                       Value="$(Version)" />
        <!--
          Three purge rows, processed together by Wix4RemoveFoldersEx. Each
          Property is ALWAYS non-empty (see the set-property actions above):
          the real folder when it should be purged, else a never-existing
          sentinel (SenHub\__no_purge__) that no-ops. Never leave a property
          empty — an empty one aborts the whole custom action (#707).
            - PURGEDATAFOLDER   : whole tree, only on PURGE_DATA=1 uninstall (#626).
            - PURGELOGSFOLDER   : logs\,   on any genuine full uninstall (#648).
            - PURGEUPDATEFOLDER : update\, on any genuine full uninstall (#648).
        -->
        <util:RemoveFolderEx Id="PurgeDataFolder"
                             On="uninstall"
                             Property="PURGEDATAFOLDER" />
        <util:RemoveFolderEx Id="PurgeLogsFolder"
                             On="uninstall"
                             Property="PURGELOGSFOLDER" />
        <util:RemoveFolderEx Id="PurgeUpdateFolder"
                             On="uninstall"
                             Property="PURGEUPDATEFOLDER" />
      </Component>

    </ComponentGroup>
  </Package>
</Wix>
