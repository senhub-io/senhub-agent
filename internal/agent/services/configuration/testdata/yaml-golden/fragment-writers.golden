===== probes.d/50-rich.yaml =====
# Managed by the SenHub web console. Edit it from the console, or remove this line to maintain it by hand.

- name: rich
  type: demo
  params:
    added:
    - a: 1
    dollar: price $5
    flag: true
    host: db.example.com
    long: 'word word word word word word word word word word word word word word word
      word word word word word word word word word word word word word word word word
      word word word word word word word word word word word word word word word word
      word word word word word word word word word word word word word '
    longword: xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
    multi: |
      line one
      line two
    multi2: |-
      no trailing newline
      second
    nested:
      deep:
        deeper:
          deepest:
          - - 1
            - 2
          - - 3
      list:
      - a
      - b
      - k: v
        "n":
        - 1
        - 2
        - 3
      none: []
    port: 5433
    ratio: 1.5
    ref: ${env:SOME_VAR:-default}
    whole: 2
    words:
    - "yes"
    - "no"
    - "on"
    - "off"
    - "y"
    - "n"
    - "true"
    - "null"
    - "~"
    - "1e3"
    - "0x10"
    - "010"
    - "2024-01-02"
    - ""
    - ' lead'
    - 'trail '
    - 'a: b'
    - '# c'
    - '- d'
    - '@at'
    - '`tick'
    - '%pct'
    - '!bang'
    - '&amp'
    - '*star'
    - '|pipe'
    - '>gt'
    - '''sq'
    - '"dq'
    - "tab\there"
    - uni é 日本
    - '{br}'
    - '[sq]'
    - x,y
    yesstr: "yes"
  custom_tags:
    empty: ""
    env: prod
    num: "5"
    "yes": "no"
  governance:
    criticality: high
    owner:
      contacts:
      - a@x
      - b@x
      team: sre
  enabled: true
  log_strategies:
  - otlp
  - event
