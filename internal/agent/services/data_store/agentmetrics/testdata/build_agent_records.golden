senhub.agent.uptime_seconds | unit="s" | type=gauge | attrs={} | value=<volatile> | desc="SenHub agent uptime in seconds since process start."
senhub.agent.cache.entries | unit="{entry}" | type=gauge | attrs={} | value=42 | desc="Number of distinct time series held in the shared metric cache."
senhub.agent.probes.active | unit="{probe}" | type=gauge | attrs={} | value=3 | desc="Number of probes that have emitted at least one data point in the cache window."
senhub.agent.probe.count | unit="{probe}" | type=gauge | attrs={} | value=5 | desc="Number of probes the agent is currently running (from configuration)."
senhub.agent.probes.healthy | unit="{probe}" | type=gauge | attrs={} | value=4 | desc="Number of running probes whose last collect cycle succeeded. Probes that have not yet completed their first cycle (or whose collection happens via a callback rather than a scheduler) are NOT counted as healthy until they explicitly publish their state."
senhub.agent.transformer.fallback | unit="{datapoint}" | type=counter | attrs={} | value=<volatile> | desc="Cumulative count of datapoints processed without a transformer YAML definition (legacy fallback: no unit injection, no unit corrections)."
senhub.agent.collect.errors | unit="{error}" | type=counter | attrs={probe=redfish,reason=timeout} | value=2 | desc="Cumulative count of probe collection errors since agent start, by probe type and reason (collect, timeout, route)."
senhub.agent.http.requests | unit="{request}" | type=counter | attrs={endpoint=/metrics} | value=8 | desc="Lifetime count of HTTP requests served per route template."
senhub.agent.otlp.metrics.pushed | unit="{record}" | type=counter | attrs={} | value=11 | desc="Cumulative count of metric records successfully pushed via OTLP/gRPC."
senhub.agent.otlp.logs.pushed | unit="{record}" | type=counter | attrs={} | value=1 | desc="Cumulative count of log records emitted via OTLP/gRPC."
senhub.agent.otlp.spans.relayed | unit="{span}" | type=counter | attrs={} | value=<volatile> | desc="Cumulative count of received spans forwarded verbatim by the trace relay. Pairs with the receiver's ingested{signal=traces} counter: equal totals mean every ingested span left the agent."
senhub.agent.otlp.logs.relayed | unit="{record}" | type=counter | attrs={} | value=<volatile> | desc="Cumulative count of ingested log records forwarded verbatim, with the emitting application's Resource preserved. Distinct from logs.pushed, which counts records the agent itself produced."
senhub.agent.otlp.metrics.relayed | unit="{point}" | type=counter | attrs={} | value=<volatile> | desc="Cumulative count of ingested metric points forwarded verbatim, with the emitting application's Resource preserved. Distinct from metrics.pushed, which counts points re-encoded from the agent's own store."
senhub.agent.otlp.dropped_log_records | unit="{record}" | type=counter | attrs={} | value=<volatile> | desc="Cumulative count of log records dropped due to subscriber backpressure on the agent log channel."
senhub.agent.self_logs.published | unit="{record}" | type=counter | attrs={} | value=<volatile> | desc="Cumulative count of the agent's own warnings and errors published on its log rail."
senhub.agent.self_logs.dropped | unit="{record}" | type=counter | attrs={} | value=<volatile> | desc="Cumulative count of the agent's own warnings and errors dropped by the self-log rate limit."
senhub.agent.entity.attribute.conflicts | unit="{conflict}" | type=counter | attrs={} | value=<volatile> | desc="Entity attributes two sources of this agent reported with different values in one cycle; each is a defect to fix, the kept value is chosen by scope order."
senhub.agent.entity.duplicates.merged | unit="{entity}" | type=counter | attrs={} | value=<volatile> | desc="Entity copies merged into another copy of the same entity because several sources of this agent reported it in one cycle."
otel.sdk.processor.log.processed | unit="{log_record}" | type=counter | attrs={error.type=queue_full,otel.component.name=senhub_entity_channel/0,otel.component.type=senhub_entity_channel} | value=<volatile> | desc="Entity events handed to the OTLP exporter; with error.type, those dropped instead."
otel.sdk.processor.log.processed | unit="{log_record}" | type=counter | attrs={otel.component.name=senhub_entity_channel/0,otel.component.type=senhub_entity_channel} | value=<volatile> | desc="Entity events handed to the OTLP exporter; with error.type, those dropped instead."
otel.sdk.processor.log.queue.size | unit="{log_record}" | type=updowncounter | attrs={otel.component.name=senhub_entity_channel/0,otel.component.type=senhub_entity_channel} | value=<volatile> | desc="Entity events waiting in the hand-off to the OTLP exporter."
otel.sdk.processor.log.queue.capacity | unit="{log_record}" | type=updowncounter | attrs={otel.component.name=senhub_entity_channel/0,otel.component.type=senhub_entity_channel} | value=<volatile> | desc="Entity events the hand-off to the OTLP exporter can hold (signals.entities.buffer_size)."
senhub.agent.otlp.dropped_span_batches | unit="{batch}" | type=counter | attrs={} | value=<volatile> | desc="Cumulative count of received span batches dropped due to backpressure on the agent span channel (the trace relay could not keep up)."
senhub.agent.otlp.buffer.fill_ratio | unit="1" | type=gauge | attrs={} | value=<volatile> | desc="Highest fill ratio (0..1) across all active log channel subscriptions at scrape time. Approaches 1 means the consumer is falling behind producers."
senhub.agent.otlp.store_size | unit="{series}" | type=gauge | attrs={} | value=77 | desc="Number of distinct series held in the OTLP strategy's last-writer-wins metric store at the last push."
senhub.agent.otlp.export.duration | unit="s" | type=gauge | attrs={window=last} | value=3 | desc="Wall-clock duration of the most recent successful OTLP metrics export."
senhub.agent.otlp.export.duration | unit="s" | type=gauge | attrs={window=mean} | value=3 | desc="All-time mean of successful OTLP metrics export durations."
senhub.agent.otlp.export.errors | unit="{error}" | type=counter | attrs={signal=logs} | value=1 | desc="Cumulative count of OTLP exports that failed after retries were exhausted, by signal."
senhub.agent.otlp.export.errors | unit="{error}" | type=counter | attrs={signal=metrics} | value=0 | desc="Cumulative count of OTLP exports that failed after retries were exhausted, by signal."
senhub.agent.otlp.export.errors | unit="{error}" | type=counter | attrs={signal=traces} | value=0 | desc="Cumulative count of OTLP exports that failed after retries were exhausted, by signal."
senhub.agent.strategy.failed | unit="" | type=gauge | attrs={reason=start,strategy=otlp} | value=1 | desc="Set to 1 while a configured strategy is not running, by strategy and reason (unknown_type, create, invalid_config, start). No series means every configured strategy started."
senhub.agent.config.watch.disabled | unit="" | type=gauge | attrs={reason=path_not_watched} | value=1 | desc="Set to 1 while the agent is not watching its configuration, by reason (watcher_unavailable, path_not_watched). A configuration change then needs an agent restart to apply. No series means the configuration is watched."
senhub.agent.otlp.dropped | unit="{record}" | type=counter | attrs={reason=dropped_by_age} | value=0 | desc="Cumulative count of OTLP records dropped before export, by reason (store_cap, queue_full, …)."
senhub.agent.otlp.dropped | unit="{record}" | type=counter | attrs={reason=logs_queue_full} | value=0 | desc="Cumulative count of OTLP records dropped before export, by reason (store_cap, queue_full, …)."
senhub.agent.otlp.dropped | unit="{record}" | type=counter | attrs={reason=memory_hard_limit} | value=0 | desc="Cumulative count of OTLP records dropped before export, by reason (store_cap, queue_full, …)."
senhub.agent.otlp.dropped | unit="{record}" | type=counter | attrs={reason=memory_soft_limit} | value=0 | desc="Cumulative count of OTLP records dropped before export, by reason (store_cap, queue_full, …)."
senhub.agent.otlp.dropped | unit="{record}" | type=counter | attrs={reason=probe_cardinality} | value=0 | desc="Cumulative count of OTLP records dropped before export, by reason (store_cap, queue_full, …)."
senhub.agent.otlp.dropped | unit="{record}" | type=counter | attrs={reason=receiver_rejected} | value=0 | desc="Cumulative count of OTLP records dropped before export, by reason (store_cap, queue_full, …)."
senhub.agent.otlp.dropped | unit="{record}" | type=counter | attrs={reason=staleness} | value=0 | desc="Cumulative count of OTLP records dropped before export, by reason (store_cap, queue_full, …)."
senhub.agent.otlp.dropped | unit="{record}" | type=counter | attrs={reason=store_cap} | value=1 | desc="Cumulative count of OTLP records dropped before export, by reason (store_cap, queue_full, …)."
senhub.agent.update.rejected | unit="{attempt}" | type=counter | attrs={reason=signature_invalid} | value=1 | desc="Cumulative count of self-update attempts refused by artifact verification, by reason."
senhub.agent.license.invalid | unit="{status}" | type=gauge | attrs={reason=binding_mismatch} | value=1 | desc="1 when a configured license was rejected and the agent degraded to free tier (by reason: validation_failed, binding_mismatch, expired_no_grace); 0 once a license validates. Absent when no license is configured."
senhub.agent.cache.dropped | unit="{datapoint}" | type=counter | attrs={reason=http_cache_cap} | value=1 | desc="Cumulative count of datapoints refused by the shared HTTP metric cache, by reason (http_cache_cap, …)."
senhub.agent.push.buffer.dropped | unit="{datapoint}" | type=counter | attrs={strategy=senhub} | value=5 | desc="Cumulative count of oldest datapoints dropped by a bounded push buffer at its cap, by strategy."
senhub.agent.export.send.failed | unit="{attempt}" | type=counter | attrs={reason=transport,strategy=otlp} | value=1 | desc="Cumulative count of failed delivery attempts by a push strategy, by strategy and reason (transport: batch kept and retried; validation/configuration: batch dropped)."
senhub.agent.export.rejected | unit="{record}" | type=counter | attrs={signal=metrics,strategy=otlp} | value=9 | desc="Cumulative count of records refused by a consumer through an OTLP partial success, by strategy and signal. These records are lost — the export reported no error and they are not retried."
senhub.agent.otlp_receiver.ingested | unit="{item}" | type=counter | attrs={signal=logs} | value=4 | desc="Cumulative count of items accepted by the OTLP receiver, by signal (metrics: emitted internal datapoints after family expansion, e.g. a summary expands to count/sum/quantile points; logs: records; traces: spans)."
senhub.agent.otlp_receiver.dropped | unit="{item}" | type=counter | attrs={reason=no_sink,signal=traces} | value=3 | desc="Cumulative count of items the OTLP receiver discarded, by signal and reason (no_sink, unmapped)."
senhub.agent.otlp_receiver.received | unit="{record}" | type=counter | attrs={origin=uds,senhub.otlp_receiver.sender.service.name=svc-a,signal=logs} | value=6 | desc="Cumulative count of records the OTLP receiver relayed, by signal, origin (uds, tcp_loopback, remote) and sending service."
senhub.agent.otlp_receiver.received.without_host_id | unit="{record}" | type=counter | attrs={origin=uds,senhub.otlp_receiver.sender.service.name=svc-a,signal=logs} | value=6 | desc="Cumulative count of relayed records that still carried no host.id once the receiver was done with them. Expected on origin=remote; a defect on uds."
senhub.agent.otlp.checkpoint.size | unit="By" | type=gauge | attrs={} | value=<volatile> | desc="Size in bytes of the most recently written OTLP checkpoint file. 0 when persistence disabled or no save has succeeded yet."
senhub.agent.otlp.checkpoint.last_save_age | unit="s" | type=gauge | attrs={} | value=<volatile> | desc="Seconds since the most recent successful OTLP checkpoint save. 0 when persistence disabled or no save has succeeded yet."
senhub.agent.otlp.checkpoint.restored_entries | unit="{series}" | type=gauge | attrs={} | value=<volatile> | desc="Number of entries restored from the OTLP checkpoint at the last agent boot. 0 means no restore (no file present, persistence disabled, or fresh install)."
senhub.agent.otlp.parallel.sub_batches | unit="{batch}" | type=gauge | attrs={} | value=<volatile> | desc="Number of sub-batches the most recent OTLP push fanned out across. 1 means the single-batch path (max_concurrent_exports=1 or cycle below threshold); >1 means per-probe parallel export fired."
senhub.agent.otlp.logs.queue.records | unit="{record}" | type=gauge | attrs={} | value=<volatile> | desc="Event-log records currently held in the on-disk dead-letter queue (awaiting replay). 0 when the backend is healthy or persistence is disabled."
senhub.agent.otlp.logs.queue.bytes | unit="By" | type=gauge | attrs={} | value=<volatile> | desc="Bytes currently held by the on-disk logs dead-letter queue."
senhub.agent.otlp.logs.queued | unit="{record}" | type=counter | attrs={} | value=<volatile> | desc="Cumulative event-log records written to the dead-letter queue after a failed export."
senhub.agent.otlp.logs.replayed | unit="{record}" | type=counter | attrs={} | value=<volatile> | desc="Cumulative event-log records re-emitted from the dead-letter queue at boot or on backend recovery."
senhub.agent.otlp.active_endpoint_index | unit="{index}" | type=gauge | attrs={} | value=<volatile> | desc="Index of the OTLP endpoint currently serving exports: 0 = primary, >0 = a configured fallback (endpoint failover, #217). Always 0 when no fallback_endpoints are configured."
senhub.agent.otlp.endpoint_switches | unit="{switch}" | type=counter | attrs={} | value=<volatile> | desc="Cumulative endpoint failover switches (the active OTLP endpoint changed). Rising means the primary is flapping."
senhub.agent.otlp.checkpoint.errors | unit="{error}" | type=counter | attrs={stage=rename} | value=1 | desc="Cumulative count of OTLP checkpoint operation failures, by stage (read, parse, version_mismatch, mkdir, create_tmp, encode, fsync, close, rename)."
senhub.agent.process.cpu.time | unit="s" | type=counter | attrs={} | value=<volatile> | desc="Cumulative CPU time consumed by the agent process since startup, in seconds."
senhub.agent.process.memory.resident | unit="By" | type=gauge | attrs={} | value=<volatile> | desc="Resident set size of the agent process, in bytes (OS-reported VmRSS / WorkingSetSize). 0 if the running OS exposes no such counter."
senhub.agent.process.memory.heap | unit="By" | type=gauge | attrs={} | value=<volatile> | desc="Go runtime heap memory currently allocated for objects, in bytes. Useful with process.memory.resident to spot heap-vs-OS memory leaks."
senhub.agent.process.goroutines | unit="{goroutine}" | type=gauge | attrs={} | value=<volatile> | desc="Number of goroutines currently running in the agent process. Monotonic growth typically indicates a goroutine leak."
senhub.agent.process.gc.cycles | unit="{cycle}" | type=counter | attrs={} | value=<volatile> | desc="Cumulative number of Go garbage collection cycles. Rate over time exposes GC pressure."
senhub.agent.process.open_fds | unit="{fd}" | type=gauge | attrs={} | value=<volatile> | desc="Open file descriptors / Windows handles for the agent process. 0 if the running OS exposes no such counter."
senhub.agent.build_info | unit="" | type=gauge | attrs={commit=abcdef0,version=1.2.3} | value=1 | desc="SenHub agent build information (gauge always 1; version and commit as labels)."
