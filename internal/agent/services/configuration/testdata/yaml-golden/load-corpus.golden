  Probes: []configuration.ProbeConfig[
    configuration.ProbeConfig{
      Name: string("42")
      Type: string("demo")
      Params: map[string]interface {}{
        string("empty_map")
        =>map[string]interface {}{
        }
        string("interval")
        =>string("30")
        string("key_with_colon")
        =>string("a:b")
        string("list_of_lists")
        =>[]interface {}[
          []interface {}[
            int(1)
            int(2)
          ]
          []interface {}[
            bool(true)
            bool(false)
          ]
          []interface {}[
          ]
        ]
      }
      CustomTags: map[string]string{
        string("a")
        =>string("0x1F")
        string("b")
        =>string("1e3")
        string("c")
        =>string("")
        string("d")
        =>string("")
        string("e")
        =>string("true")
        string("f")
        =>string("2024-01-02")
        string("g")
        =>string("off")
      }
      Governance: nil(map[string]interface {})
