    {
      "type": "row",
      "id": 19,
      "title": "Logs",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 39
      },
      "panels": []
    },
    {
      "type": "logs",
      "title": "Recent logs",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "defqbr545b18gf"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "defqbr545b18gf"
          },
          "expr": "azure_job:~\"^${job:regex}$\" AND (severity_text:~\"^(${severity:pipe})$\" OR severity:~\"^(${severity:pipe})$\" OR ((severity_text:\"\" OR severity_text:=\"Unspecified\") AND severity:\"\")) | copy severity_text as level | sort by (_time desc) | limit 500",
          "editorMode": "code",
          "queryType": "instant",
          "maxLines": 500
        }
