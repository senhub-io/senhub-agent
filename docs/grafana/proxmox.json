{
  "uid": "senhub-proxmox",
  "title": "SenHub Proxmox VE — Overview",
  "tags": ["senhub", "agents", "proxmox"],
  "timezone": "browser",
  "refresh": "1m",
  "time": { "from": "now-24h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Proxmox cluster",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "victoriametrics" },
        "query": "label_values(proxmox_node_status, service_name)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "current": { "selected": true, "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    { "type": "row", "id": 1, "title": "Headline", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "panels": [] },
    {
      "type": "stat",
      "id": 10,
      "title": "Nodes online",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [{ "refId": "A", "expr": "sum(proxmox_node_status{service_name=~\"$service\"} == 1)", "instant": true }],
      "fieldConfig": { "defaults": { "decimals": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "value", "colorMode": "background_solid" }
    },
    {
      "type": "stat",
      "id": 11,
      "title": "Running guests",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [{ "refId": "A", "expr": "sum(proxmox_vm_status{service_name=~\"$service\"} == 1)", "instant": true }],
      "fieldConfig": { "defaults": { "decimals": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "value", "colorMode": "background_solid" }
    },
    {
      "type": "stat",
      "id": 12,
      "title": "Failed tasks",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [{ "refId": "A", "expr": "sum(proxmox_task_count{service_name=~\"$service\",proxmox_task_state=\"failed\"})", "instant": true }],
      "fieldConfig": { "defaults": { "decimals": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 3 }] } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "value", "colorMode": "value" }
    },
    {
      "type": "stat",
      "id": 13,
      "title": "Unprotected guests",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [{ "refId": "A", "expr": "sum(proxmox_vm_backup_unprotected_count{service_name=~\"$service\"})", "instant": true }],
      "fieldConfig": { "defaults": { "decimals": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "value", "colorMode": "background_solid" }
    },
    {
      "type": "stat",
      "id": 14,
      "title": "HA quorum",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [{ "refId": "A", "expr": "sum(proxmox_ha_quorum_status{service_name=~\"$service\",proxmox_ha_quorum_state=\"ok\"} == 1)", "instant": true }],
      "fieldConfig": { "defaults": { "decimals": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "value", "colorMode": "background_solid" }
    },
    {
      "type": "stat",
      "id": 15,
      "title": "Failing replication jobs",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [{ "refId": "A", "expr": "sum(proxmox_replication_job_status{service_name=~\"$service\",proxmox_replication_job_state=\"failed\"} == 1)", "instant": true }],
      "fieldConfig": { "defaults": { "decimals": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 3 }] } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "value", "colorMode": "value" }
    },
    { "type": "row", "id": 2, "title": "Nodes", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 }, "panels": [] },
    {
      "type": "timeseries",
      "id": 20,
      "title": "Node CPU utilization",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [{ "refId": "A", "expr": "avg by(proxmox_node) (proxmox_node_cpu_utilization_ratio{service_name=~\"$service\"})", "legendFormat": "{{proxmox_node}}" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10 } } },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last"] } }
    },
    {
      "type": "timeseries",
      "id": 21,
      "title": "Node memory used",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [{ "refId": "A", "expr": "proxmox_node_memory_used_bytes{service_name=~\"$service\"}", "legendFormat": "{{proxmox_node}}" }],
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10 } } },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last"] } }
    },
    { "type": "row", "id": 3, "title": "Guests", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 }, "panels": [] },
    {
      "type": "timeseries",
      "id": 30,
      "title": "Guest CPU utilization",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [{ "refId": "A", "expr": "avg by(proxmox_vm_name) (proxmox_vm_cpu_utilization_ratio{service_name=~\"$service\"})", "legendFormat": "{{proxmox_vm_name}}" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10 } } },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last"] } }
    },
    {
      "type": "timeseries",
      "id": 31,
      "title": "Guest memory used",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [{ "refId": "A", "expr": "sum by(proxmox_vm_name) (proxmox_vm_memory_used_bytes{service_name=~\"$service\"})", "legendFormat": "{{proxmox_vm_name}}" }],
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10 } } },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last"] } }
    },
    {
      "type": "timeseries",
      "id": 32,
      "title": "Guest disk read rate",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 23 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [{ "refId": "A", "expr": "sum by(proxmox_vm_name) (rate(proxmox_vm_disk_read_bytes_total{service_name=~\"$service\"}[$__rate_interval]))", "legendFormat": "{{proxmox_vm_name}}" }],
      "fieldConfig": { "defaults": { "unit": "Bps", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10 } } },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last"] } }
    },
    {
      "type": "timeseries",
      "id": 33,
      "title": "Guest disk write rate",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 23 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [{ "refId": "A", "expr": "sum by(proxmox_vm_name) (rate(proxmox_vm_disk_write_bytes_total{service_name=~\"$service\"}[$__rate_interval]))", "legendFormat": "{{proxmox_vm_name}}" }],
      "fieldConfig": { "defaults": { "unit": "Bps", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10 } } },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last"] } }
    },
    {
      "type": "timeseries",
      "id": 34,
      "title": "Guest network in rate",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 31 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [{ "refId": "A", "expr": "sum by(proxmox_vm_name) (rate(proxmox_vm_network_in_bytes_total{service_name=~\"$service\"}[$__rate_interval]))", "legendFormat": "{{proxmox_vm_name}}" }],
      "fieldConfig": { "defaults": { "unit": "Bps", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10 } } },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last"] } }
    },
    {
      "type": "timeseries",
      "id": 35,
      "title": "Guest network out rate",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 31 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [{ "refId": "A", "expr": "sum by(proxmox_vm_name) (rate(proxmox_vm_network_out_bytes_total{service_name=~\"$service\"}[$__rate_interval]))", "legendFormat": "{{proxmox_vm_name}}" }],
      "fieldConfig": { "defaults": { "unit": "Bps", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10 } } },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last"] } }
    },
    { "type": "row", "id": 4, "title": "Storage", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 39 }, "panels": [] },
    {
      "type": "timeseries",
      "id": 40,
      "title": "Storage usage ratio",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 40 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [{ "refId": "A", "expr": "proxmox_storage_used_bytes{service_name=~\"$service\"} / proxmox_storage_limit_bytes{service_name=~\"$service\"}", "legendFormat": "{{proxmox_storage}}" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10 } } },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last"] } }
    },
    {
      "type": "table",
      "id": 41,
      "title": "Storage status (non-active)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 40 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [{ "refId": "A", "expr": "proxmox_storage_status{service_name=~\"$service\",proxmox_storage_state!=\"active\"} == 1", "legendFormat": "{{proxmox_storage}}", "format": "table", "instant": true }],
      "fieldConfig": { "defaults": { "custom": { "align": "auto" } }, "overrides": [] },
      "options": { "showHeader": true }
    },
    { "type": "row", "id": 5, "title": "Physical disks", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 48 }, "panels": [] },
    {
      "type": "table",
      "id": 50,
      "title": "Physical disk status (non-ok)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 49 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [{ "refId": "A", "expr": "hw_physical_disk_status{service_name=~\"$service\",hw_state!=\"ok\"} == 1", "legendFormat": "{{hw_name}} ({{hw_id}})", "format": "table", "instant": true }],
      "fieldConfig": { "defaults": { "custom": { "align": "auto" } }, "overrides": [] },
      "options": { "showHeader": true }
    },
    {
      "type": "timeseries",
      "id": 51,
      "title": "Physical disk endurance utilization",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 49 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [{ "refId": "A", "expr": "hw_physical_disk_endurance_utilization_ratio{service_name=~\"$service\"}", "legendFormat": "{{hw_name}} ({{hw_id}})" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10 } } },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last"] } }
    },
    { "type": "row", "id": 6, "title": "ZFS pools", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 57 }, "panels": [] },
    {
      "type": "table",
      "id": 60,
      "title": "ZFS pool status (non-ok)",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 58 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [{ "refId": "A", "expr": "hw_logical_disk_status{service_name=~\"$service\",hw_state!=\"ok\"} == 1", "legendFormat": "{{hw_id}} {{hw_state}}", "format": "table", "instant": true }],
      "fieldConfig": { "defaults": { "custom": { "align": "auto" } }, "overrides": [] },
      "options": { "showHeader": true }
    },
    {
      "type": "timeseries",
      "id": 61,
      "title": "ZFS pool usage ratio",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 58 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [{ "refId": "A", "expr": "sum by(proxmox_node, hw_id) (hw_logical_disk_usage_bytes{service_name=~\"$service\",hw_logical_disk_state=\"used\"}) / sum by(proxmox_node, hw_id) (hw_logical_disk_limit_bytes{service_name=~\"$service\"})", "legendFormat": "{{proxmox_node}}/{{hw_id}}" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10 } } },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last"] } }
    },
    {
      "type": "timeseries",
      "id": 62,
      "title": "ZFS pool fragmentation",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 58 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [{ "refId": "A", "expr": "avg by(proxmox_node) (proxmox_zfs_pool_fragmentation_ratio{service_name=~\"$service\"})", "legendFormat": "{{proxmox_node}}" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10 } } },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last"] } }
    },
    { "type": "row", "id": 7, "title": "Backups", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 66 }, "panels": [] },
    {
      "type": "timeseries",
      "id": 70,
      "title": "Backup age per VM",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 67 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [{ "refId": "A", "expr": "proxmox_vm_backup_age_seconds{service_name=~\"$service\"}", "legendFormat": "{{proxmox_vm_name}}" }],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10 } } },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last"] } }
    },
    {
      "type": "table",
      "id": 71,
      "title": "Last backup failed",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 67 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [{ "refId": "A", "expr": "proxmox_vm_backup_status{service_name=~\"$service\",proxmox_vm_backup_state=\"failed\"} == 1", "legendFormat": "{{proxmox_vm_name}}", "format": "table", "instant": true }],
      "fieldConfig": { "defaults": { "custom": { "align": "auto" } }, "overrides": [] },
      "options": { "showHeader": true }
    },
    {
      "type": "stat",
      "id": 72,
      "title": "Unprotected guests",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 75 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [{ "refId": "A", "expr": "sum(proxmox_vm_backup_unprotected_count{service_name=~\"$service\"})", "instant": true }],
      "fieldConfig": { "defaults": { "decimals": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "value", "colorMode": "background_solid" }
    },
    {
      "type": "stat",
      "id": 73,
      "title": "Backup job count",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 75 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [{ "refId": "A", "expr": "sum(proxmox_backup_job_count{service_name=~\"$service\"})", "instant": true }],
      "fieldConfig": { "defaults": { "decimals": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "value", "colorMode": "background_solid" }
    },
    { "type": "row", "id": 8, "title": "Tasks", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 79 }, "panels": [] },
    {
      "type": "timeseries",
      "id": 80,
      "title": "Failed task count over time per type",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 80 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [{ "refId": "A", "expr": "sum by(proxmox_task_type) (proxmox_task_count{service_name=~\"$service\",proxmox_task_state=\"failed\"})", "legendFormat": "{{proxmox_task_type}}" }],
      "fieldConfig": { "defaults": { "decimals": 0, "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10 } } },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last"] } }
    },
    { "type": "row", "id": 9, "title": "High availability", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 88 }, "panels": [] },
    {
      "type": "table",
      "id": 90,
      "title": "HA resource status",
      "gridPos": { "h": 8, "w": 18, "x": 0, "y": 89 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [{ "refId": "A", "expr": "proxmox_ha_resource_status{service_name=~\"$service\"} == 1", "legendFormat": "{{proxmox_ha_resource}} {{proxmox_ha_resource_state}}", "format": "table", "instant": true }],
      "fieldConfig": { "defaults": { "custom": { "align": "auto" } }, "overrides": [] },
      "options": { "showHeader": true }
    },
    {
      "type": "stat",
      "id": 91,
      "title": "HA quorum",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 89 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [{ "refId": "A", "expr": "sum(proxmox_ha_quorum_status{service_name=~\"$service\",proxmox_ha_quorum_state=\"ok\"} == 1)", "instant": true }],
      "fieldConfig": { "defaults": { "decimals": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "value", "colorMode": "background_solid" }
    },
    { "type": "row", "id": 10, "title": "Replication", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 97 }, "panels": [] },
    {
      "type": "table",
      "id": 100,
      "title": "Replication job status",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 98 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [{ "refId": "A", "expr": "proxmox_replication_job_status{service_name=~\"$service\"} == 1", "legendFormat": "{{proxmox_replication_job}} {{proxmox_replication_job_state}}", "format": "table", "instant": true }],
      "fieldConfig": { "defaults": { "custom": { "align": "auto" } }, "overrides": [] },
      "options": { "showHeader": true }
    },
    {
      "type": "timeseries",
      "id": 101,
      "title": "Replication job age",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 98 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [{ "refId": "A", "expr": "proxmox_replication_job_age_seconds{service_name=~\"$service\"}", "legendFormat": "{{proxmox_replication_job}}" }],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10 } } },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last"] } }
    }
  ],
  "schemaVersion": 39,
  "version": 1
}
