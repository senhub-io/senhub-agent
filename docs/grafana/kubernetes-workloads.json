{
  "uid": "senhub-kubernetes-workloads",
  "title": "SenHub Kubernetes \u2014 Workloads",
  "description": "Node, pod and container usage from the kubelet_stats probe.",
  "tags": [
    "senhub",
    "agents",
    "kubernetes"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "schemaVersion": 39,
  "version": 1,
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "refresh": 1,
        "current": {
          "selected": true,
          "text": "VictoriaMetrics",
          "value": "victoriametrics"
        }
      },
      {
        "name": "host",
        "label": "Cluster / Host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(k8s_node_cpu_usage{host_name!=\"\"}, host_name)",
        "refresh": 1,
        "includeAll": true,
        "multi": false,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(k8s_pod_cpu_usage{host_name=~\"$host\"}, k8s_namespace_name)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "pod",
        "label": "Pod",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(k8s_pod_cpu_usage{host_name=~\"$host\", k8s_namespace_name=~\"$namespace\"}, k8s_pod_name)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "container",
        "label": "Container",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(container_cpu_usage{host_name=~\"$host\", k8s_namespace_name=~\"$namespace\", k8s_pod_name=~\"$pod\"}, k8s_container_name)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "id": 1,
      "title": "Node",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Node CPU usage",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (k8s_node_name) (k8s_node_cpu_usage{host_name=~\"$host\"})",
          "legendFormat": "{{k8s_node_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1
          },
          "unit": "cores"
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 2,
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 1
      }
    },
    {
      "type": "timeseries",
      "title": "Node memory working set",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (k8s_node_name) (k8s_node_memory_working_set_bytes{host_name=~\"$host\"})",
          "legendFormat": "{{k8s_node_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1
          },
          "unit": "bytes"
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 3,
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 1
      }
    },
    {
      "type": "timeseries",
      "title": "Node network rx/tx rate",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (k8s_node_name, direction) (rate(k8s_node_network_io_bytes_total{host_name=~\"$host\"}[$__rate_interval]))",
          "legendFormat": "{{k8s_node_name}} {{direction}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1
          },
          "unit": "Bps"
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 4,
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 1
      }
    },
    {
      "type": "timeseries",
      "title": "Node filesystem usage",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (k8s_node_name) (k8s_node_filesystem_usage_bytes{host_name=~\"$host\"})",
          "legendFormat": "{{k8s_node_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1
          },
          "unit": "bytes"
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 5,
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 1
      }
    },
    {
      "type": "row",
      "id": 6,
      "title": "Pods",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Top pods by CPU",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(5, sum by (k8s_namespace_name, k8s_pod_name) (k8s_pod_cpu_usage{host_name=~\"$host\", k8s_namespace_name=~\"$namespace\", k8s_pod_name=~\"$pod\"}))",
          "legendFormat": "{{k8s_namespace_name}}/{{k8s_pod_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1
          },
          "unit": "cores"
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 7,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 10
      }
    },
    {
      "type": "timeseries",
      "title": "Top pods by memory working set",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(5, sum by (k8s_namespace_name, k8s_pod_name) (k8s_pod_memory_working_set_bytes{host_name=~\"$host\", k8s_namespace_name=~\"$namespace\", k8s_pod_name=~\"$pod\"}))",
          "legendFormat": "{{k8s_namespace_name}}/{{k8s_pod_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1
          },
          "unit": "bytes"
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 8,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 10
      }
    },
    {
      "type": "table",
      "title": "Pods",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (k8s_namespace_name, k8s_pod_name) (k8s_pod_cpu_usage{host_name=~\"$host\", k8s_namespace_name=~\"$namespace\", k8s_pod_name=~\"$pod\"})",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "expr": "max by (k8s_namespace_name, k8s_pod_name) (k8s_pod_memory_working_set_bytes{host_name=~\"$host\", k8s_namespace_name=~\"$namespace\", k8s_pod_name=~\"$pod\"})",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "k8s_namespace_name": "Namespace",
              "k8s_pod_name": "Pod"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "Namespace"
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value #A"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "CPU"
              },
              {
                "id": "unit",
                "value": "cores"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #B"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Memory"
              },
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        }
      },
      "description": "One row per pod. Restarts are not reported by the kubelet_stats probe.",
      "id": 9,
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 18
      }
    },
    {
      "type": "row",
      "id": 10,
      "title": "Containers",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 28
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Container CPU usage",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (k8s_container_name) (container_cpu_usage{host_name=~\"$host\", k8s_namespace_name=~\"$namespace\", k8s_pod_name=~\"$pod\", k8s_container_name=~\"$container\"})",
          "legendFormat": "{{k8s_container_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1
          },
          "unit": "cores"
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 11,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 29
      }
    },
    {
      "type": "timeseries",
      "title": "Container memory working set",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (k8s_container_name) (container_memory_working_set_bytes{host_name=~\"$host\", k8s_namespace_name=~\"$namespace\", k8s_pod_name=~\"$pod\", k8s_container_name=~\"$container\"})",
          "legendFormat": "{{k8s_container_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1
          },
          "unit": "bytes"
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 12,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 29
      }
    },
    {
      "type": "row",
      "id": 13,
      "title": "Probe health",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 37
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Kubelet scrape errors by reason",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (rate(senhub_kubelet_stats_scrape_errors_total{host_name=~\"$host\"}[$__rate_interval]))",
          "legendFormat": "{{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal"
            }
          },
          "unit": "short"
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 14,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 38
      }
    },
    {
      "type": "stat",
      "title": "Pods seen",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(senhub_kubelet_stats_pods_seen{host_name=~\"$host\"})",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value",
        "colorMode": "background_solid"
      },
      "id": 15,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 38
      }
    }
  ]
}
