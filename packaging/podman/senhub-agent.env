# Environment of the SenHub Agent container, read by senhub-agent.container.
#
# One KEY=value per line. Podman takes the value literally: no quotes,
# no multi-line values. The entrypoint reads these on the first start
# only, when the configuration volume holds no agent.yaml yet.
#
# No secret belongs here (`podman inspect` prints this file's values). OTLP_BEARER_TOKEN, SENHUB_LICENSE and
# SENHUB_PROBE_ACA_CLIENT_SECRET_FILE are given as Podman secrets: see the
# Secret= lines of senhub-agent.container.
#
# Every variable is described in docs/user-guide/docs/container.md.

# --- Export ---
# Another OTLP collector. Defaults to SenHub when OTLP_BEARER_TOKEN is set.
#SENHUB_OTLP_ENDPOINT=collector.example.test:4317
# grpc (default) or http.
#SENHUB_OTLP_PROTOCOL=grpc
# false for a collector listening in plain text on a trusted network.
#SENHUB_OTLP_TLS=true
# false exports measurements and logs without entities.
#SENHUB_ENTITIES=true

# --- Every metric ---
#SENHUB_TAGS=site=paris,env=prod

# --- HTTP output (console, PRTG, Nagios, Prometheus) ---
# Host scope (shipped): the port opens on the host itself, free it first.
# Change HealthCmd= in the unit to match; container scope also PublishPort=.
#SENHUB_HTTP_PORT=8080
#SENHUB_HTTP_BIND=0.0.0.0

# --- Zabbix ---
#SENHUB_ZABBIX_SERVER=zabbix.example.test:10051
#SENHUB_ZABBIX_HOST_METADATA=senhub-agent

# --- Identity ---
# Only when no state volume can be kept. One value per instance, never
# an example value.
#SENHUB_HOST_ID=
#SENHUB_AGENT_KEY=

# --- Azure Container Apps log stream ---
# One probe per name. The client secret is a mounted file (see the unit),
# not a line here.
#SENHUB_PROBE_ACA_TYPE=azure_container_apps
#SENHUB_PROBE_ACA_TENANT_ID=
#SENHUB_PROBE_ACA_CLIENT_ID=
#SENHUB_PROBE_ACA_SUBSCRIPTION_ID=
#SENHUB_PROBE_ACA_BOOKMARK_PATH=/var/lib/senhub-agent/aca.bookmark

# SENHUB_PROBES and SENHUB_OUTPUT carry multi-line YAML, which this file
# cannot hold. Mount a probes.d directory instead (see the unit).
