# Auto detect text files and perform LF normalization
* text=auto
*.go text eol=lf
*.mod text eol=lf
*.sum text eol=lf

# systemd units are Linux-only text embedded via go:embed; a CRLF checkout
# on a Windows runner leaves a stray \r on every line and breaks the
# unit-contract tests (packagedExecStartLine vs installedExecStart).
*.service text eol=lf

# Windows files
*.{cmd,[cC][mM][dD]} text eol=crlf
*.{bat,[bB][aA][tT]} text eol=crlf

# Golden output files are compared byte-for-byte by the test harness:
# never apply EOL conversion (Windows checkouts turned LF goldens into
# CRLF and every golden comparison failed on windows runners).
*.golden -text
