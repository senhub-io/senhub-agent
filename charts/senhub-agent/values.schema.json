{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "senhub-agent chart values",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "stringOrEmpty": { "type": "string" },
    "boolOrEmpty": {
      "description": "true, false, or empty to leave the entrypoint default",
      "oneOf": [
        { "type": "boolean" },
        { "type": "string", "enum": ["", "true", "false"] }
      ]
    },
    "stringMap": {
      "type": "object",
      "additionalProperties": { "type": ["string", "number", "boolean"] }
    },
    "fragmentKey": { "pattern": "^[a-z0-9][a-z0-9_-]*$" },
    "probeHandler": { "type": ["object", "null"] }
  },
  "properties": {
    "global": { "type": "object" },
    "edition": { "type": "string", "enum": ["full", "oss"] },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string" },
        "tag": { "type": "string" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": { "type": "array" },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "kind": { "type": "string", "enum": ["", "Deployment", "DaemonSet"] },
    "daemonSet": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stateHostPath": { "type": "string", "pattern": "^/.+[^/]$" }
      }
    },
    "hostMonitoring": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "hostRoot": { "type": "string", "pattern": "^/[^/].*[^/]$|^/[^/]$" }
      }
    },
    "logLevel": { "type": "string", "enum": ["info", "debug"] },
    "logFilter": { "type": "string" },
    "hostname": {
      "type": "string",
      "pattern": "^$|^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": { "type": "string" },
        "hostId": {
          "type": "string",
          "pattern": "^$|^[0-9a-fA-F-]{32,36}$"
        },
        "agentKey": {
          "type": "string",
          "pattern": "^$|^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        }
      }
    },
    "env": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "otlpEndpoint": { "type": "string" },
        "otlpProtocol": { "type": "string", "enum": ["", "grpc", "http"] },
        "otlpTLS": { "$ref": "#/definitions/boolOrEmpty" },
        "entities": { "$ref": "#/definitions/boolOrEmpty" },
        "tags": { "$ref": "#/definitions/stringMap" },
        "zabbixServer": { "type": "string" },
        "zabbixHostMetadata": { "type": "string" },
        "azure": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "app": { "type": "string" },
            "tenantId": { "type": "string" },
            "clientId": { "type": "string" },
            "subscriptionId": { "type": "string" },
            "resourceGroup": { "type": "string" }
          }
        },
        "timezone": { "type": "string" }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": { "type": "string" },
        "values": {
          "type": "object",
          "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
          "additionalProperties": { "type": ["string", "number", "boolean"] }
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "probes": {
          "type": "object",
          "propertyNames": { "$ref": "#/definitions/fragmentKey" },
          "additionalProperties": { "type": ["array", "object", "string"] }
        },
        "strategies": {
          "type": "object",
          "propertyNames": { "$ref": "#/definitions/fragmentKey" },
          "additionalProperties": { "type": ["object", "string"] }
        },
        "agent": { "type": "object" }
      }
    },
    "http": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "bind": { "type": "string" }
      }
    },
    "kubernetesProbe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "name": { "type": "string", "minLength": 1 },
        "params": { "type": "object" }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object" },
        "automountToken": { "type": "boolean" }
      }
    },
    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kubernetesProbe": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "enabled": { "type": "boolean" } }
        }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "existingClaim": { "type": "string" },
        "storageClass": { "type": "string" },
        "accessModes": { "type": "array", "items": { "type": "string" } },
        "size": { "type": "string" },
        "annotations": { "type": "object" }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "annotations": { "type": "object" }
      }
    },
    "serviceMonitor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "interval": { "type": "string" },
        "scrapeTimeout": { "type": "string" },
        "labels": { "type": "object" },
        "metricRelabelings": { "type": "array" },
        "relabelings": { "type": "array" }
      }
    },
    "resources": { "type": "object" },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "startupProbe": { "$ref": "#/definitions/probeHandler" },
    "livenessProbe": { "$ref": "#/definitions/probeHandler" },
    "readinessProbe": { "$ref": "#/definitions/probeHandler" },
    "extraEnv": { "type": "array" },
    "extraVolumes": { "type": "array" },
    "extraVolumeMounts": { "type": "array" },
    "podAnnotations": { "type": "object" },
    "podLabels": { "type": "object" },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" },
    "priorityClassName": { "type": "string" },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 }
  }
}
