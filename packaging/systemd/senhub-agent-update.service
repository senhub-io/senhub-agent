[Unit]
Description=SenHub Agent update, applied as root on the service's request
Documentation=https://github.com/senhub-io/senhub-agent
After=network-online.target
Wants=network-online.target
# No systemd start limit: hitting it would fail the path unit for good, and
# no later request would ever be handled. The limit is in update-apply, which
# refuses more than six attempts in the last hour (rate_limited) and recovers
# by itself; a rollback is never refused for it.
StartLimitIntervalSec=0

[Service]
Type=oneshot
# `update-apply` takes no argument and no input but the request file, which it
# audits before doing anything: owner, mode, type, size, content, then the
# signed version list, the archive hash and its signature.
ExecStart=/usr/bin/senhub-agent update-apply
TimeoutStartSec=900
# At most one run every two seconds, whatever the service writes: a request
# is deleted by the first thing update-apply does, so nothing retriggers the
# path unit, and this keeps even a hostile writer to a trickle.
ExecStopPost=-/usr/bin/sleep 2
User=root

# Root's own state: the list sequence floor and the update lock, out of reach
# of the service user (/var/lib/senhub-agent-update, 0700).
StateDirectory=senhub-agent-update
StateDirectoryMode=0700

# Read-only system except what an update writes: the binary and the files kept
# beside it (/usr/bin), and the service's state directory (request, rollback
# markers).
ProtectSystem=strict
ReadWritePaths=/usr/bin /var/lib/senhub-agent
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
NoNewPrivileges=true

# DAC_OVERRIDE and FOWNER: read and remove the request in the service's
# directory, write the rollback markers there. Nothing else is granted.
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_FOWNER
AmbientCapabilities=

ProtectHostname=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
RemoveIPC=true
UMask=0022
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# The registry over HTTPS (inet, inet6, DNS stub), and systemd's private
# socket to restart the service (unix).
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
