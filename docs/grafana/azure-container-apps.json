{
  "uid": "senhub-azure-container-apps",
  "title": "SenHub Azure CA — Container Apps",
  "description": "Coverage, per-application health, volume and logs for Azure Container Apps (CA).",
  "tags": [
    "senhub",
    "agents",
    "azure"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "schemaVersion": 39,
  "version": 1,
  "templating": {
    "list": [
      {
        "name": "app",
        "label": "Application",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "query": "label_values(senhub_azure_container_apps_up{azure_app!=\"\"}, azure_app)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "severity",
        "label": "Severity",
        "type": "custom",
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": [
            "WARN",
            "ERROR",
            "FATAL"
          ],
          "value": [
            "WARN",
            "ERROR",
            "FATAL"
          ]
        },
        "options": [
          {
            "text": "TRACE",
            "value": "TRACE",
            "selected": false
          },
          {
            "text": "DEBUG",
            "value": "DEBUG",
            "selected": false
          },
          {
            "text": "INFO",
            "value": "INFO",
            "selected": false
          },
          {
            "text": "WARN",
            "value": "WARN",
            "selected": true
          },
          {
            "text": "ERROR",
            "value": "ERROR",
            "selected": true
          },
          {
            "text": "FATAL",
            "value": "FATAL",
            "selected": true
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "id": 1,
      "title": "Coverage",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Followed",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(senhub_azure_container_apps_discovery_followed)",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value",
        "colorMode": "background_solid"
      },
      "description": "Applications this collector reads. Expected metric: not yet emitted by every release.",
      "id": 2,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Found",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(senhub_azure_container_apps_discovery_found)",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value",
        "colorMode": "background_solid"
      },
      "description": "Applications the subscription holds.",
      "id": 3,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Left out by filter",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(max by (reason) (last_over_time(senhub_azure_container_apps_discovery_left_out{reason=\"filter\"}[5m]))) or vector(0)",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value",
        "colorMode": "background_solid"
      },
      "id": 4,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Left out by max_apps cap",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(max by (reason) (last_over_time(senhub_azure_container_apps_discovery_left_out{reason=\"max_apps\"}[5m]))) or vector(0)",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value",
        "colorMode": "background_solid"
      },
      "description": "Above zero means applications exist that the instance does not follow because of the max_apps cap.",
      "id": 5,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Last discovery",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min(senhub_azure_container_apps_discovery_last_age_seconds)",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 900
              },
              {
                "color": "red",
                "value": 3600
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value",
        "colorMode": "background_solid"
      },
      "description": "Age of the last successful enumeration of the subscription.",
      "id": 6,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Discovery failures (range)",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(senhub_azure_container_apps_discovery_failures_total[$__range]))",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value",
        "colorMode": "background_solid"
      },
      "id": 7,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Coverage",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(senhub_azure_container_apps_discovery_followed) / max(senhub_azure_container_apps_discovery_found)",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.8
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value",
        "colorMode": "background_solid"
      },
      "id": 8,
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 5
      }
    },
    {
      "type": "stat",
      "title": "Control plane",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min(max by (azure_app) (senhub_azure_container_apps_up{azure_app=~\"$app\",azure_app!=\"\"}))",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Down"
                },
                "1": {
                  "text": "Up"
                }
              }
            }
          ]
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value",
        "colorMode": "background_solid"
      },
      "description": "Lowest up value across the followed applications.",
      "id": 9,
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 5
      }
    },
    {
      "type": "stat",
      "title": "Replicas followed",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(max by (azure_app) (senhub_azure_container_apps_replicas{azure_app=~\"$app\",azure_app!=\"\"}))",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value",
        "colorMode": "background_solid"
      },
      "id": 10,
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 5
      }
    },
    {
      "type": "stat",
      "title": "Streams open",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(max by (azure_app) (senhub_azure_container_apps_streams_open{azure_app=~\"$app\",azure_app!=\"\"}))",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value",
        "colorMode": "background_solid"
      },
      "id": 11,
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 5
      }
    },
    {
      "type": "row",
      "id": 12,
      "title": "Applications",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "panels": []
    },
    {
      "type": "table",
      "title": "Per application, over the selected range",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (azure_app) (senhub_azure_container_apps_up{azure_app=~\"$app\",azure_app!=\"\"})",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "expr": "max by (azure_app) (senhub_azure_container_apps_replicas{azure_app=~\"$app\",azure_app!=\"\"})",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "C",
          "expr": "max by (azure_app) (senhub_azure_container_apps_streams_open{azure_app=~\"$app\",azure_app!=\"\"})",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "D",
          "expr": "max by (azure_app) (senhub_azure_container_apps_streams_wanted{azure_app=~\"$app\",azure_app!=\"\"})",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "E",
          "expr": "sum by (azure_app) (rate(senhub_azure_container_apps_records_emitted_total{azure_app=~\"$app\",azure_app!=\"\"}[$__range]))",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "F",
          "expr": "sum by (azure_app) (increase(senhub_azure_container_apps_records_dropped_total{azure_app=~\"$app\",azure_app!=\"\"}[$__range]))",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "G",
          "expr": "sum by (azure_app) (increase(senhub_azure_container_apps_records_unparsed_total{azure_app=~\"$app\",azure_app!=\"\"}[$__range]))",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "H",
          "expr": "sum by (azure_app) (increase(senhub_azure_container_apps_stream_reconnects_total{azure_app=~\"$app\",azure_app!=\"\"}[$__range]))",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "azure_app": "Application",
              "azure_job": "Job",
              "reason": "Reason"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "Application"
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value #A"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Up"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #B"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Replicas"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #C"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Streams open"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #D"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Streams wanted"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #E"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Records/s"
              },
              {
                "id": "unit",
                "value": "short"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #F"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Dropped"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #G"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Unparsed"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #H"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Reconnects"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #A"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Up"
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "Down",
                        "color": "red"
                      },
                      "1": {
                        "text": "Up",
                        "color": "green"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "Application",
            "desc": false
          }
        ]
      },
      "description": "One row per application. Records/s is the average over the range. Dropped counts lines removed at the source by exclude patterns or min_severity.",
      "id": 13,
      "gridPos": {
        "h": 22,
        "w": 24,
        "x": 0,
        "y": 10
      }
    },
    {
      "type": "row",
      "id": 14,
      "title": "Scan failures",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "panels": []
    },
    {
      "type": "table",
      "title": "Scan failures by application and reason, over the selected range",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (azure_app, reason) (increase(senhub_azure_container_apps_scan_failures_total{azure_app=~\"$app\",azure_app!=\"\"}[$__range]))",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "azure_app": "Application",
              "azure_job": "Job",
              "reason": "Reason"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value #A"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Failures"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        }
      },
      "description": "Replica scans Azure refused: denied, not_found, throttled, refused, timeout, unreachable.",
      "id": 15,
      "gridPos": {
        "h": 8,
        "w": 10,
        "x": 0,
        "y": 33
      }
    },
    {
      "type": "timeseries",
      "title": "Scan failures by reason",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (increase(senhub_azure_container_apps_scan_failures_total{azure_app=~\"$app\",azure_app!=\"\"}[$__interval]))",
          "legendFormat": "{{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal"
            }
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 16,
      "gridPos": {
        "h": 8,
        "w": 14,
        "x": 10,
        "y": 33
      }
    },
    {
      "type": "row",
      "id": 17,
      "title": "Volume",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 41
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Records per second by application",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (azure_app) (rate(senhub_azure_container_apps_records_emitted_total{azure_app=~\"$app\",azure_app!=\"\"}[$__rate_interval]))",
          "legendFormat": "{{azure_app}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1
          },
          "unit": "short"
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
