http:
  bind: 0.0.0.0
  endpoints:
  - prtg
  - web
  long: 'segment segment segment segment segment segment segment segment segment segment
    segment segment segment segment segment segment segment segment segment segment
    segment segment segment segment segment segment segment segment segment segment
    segment segment segment segment segment segment segment segment segment segment '
  multi: |
    a
    b
  port: 9090
  ratio: 0.5
  tls:
    cipher_suites:
    - A
    - B
    enabled: true
    min: "1.2"
  word: "yes"
