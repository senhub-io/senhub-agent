===== file a/strategies.d/10-otlp.yaml =====
# SenHub Agent — OTLP export strategy (provisioned by 'config init').
# Pushes metrics and logs to an OpenTelemetry collector (or an
# OTLP-compatible backend: VictoriaMetrics, Grafana Alloy, ...).
otlp:
  endpoint: otlp.example.com:4317
  protocol: http
===== file a/strategies.d/20-zabbix.yaml =====
# SenHub Agent — Zabbix output (provisioned by 'config init').
# Registers this host by autoregistration and pushes its values as an
# active agent. Prepare the server once with 'senhub-agent zabbix setup'.
zabbix:
  server: "zbx.example.com"
  host_metadata: "meta"
